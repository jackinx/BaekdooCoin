# 백두코인봇 (Windows) — 환경 변수 예시
# 복사: copy .env.example .env  → 값 채우기
# ⚠️ 업비트 API 키는 '자산 조회 / 주문 조회 / 주문하기'만 체크. 출금 권한은 절대 체크하지 말 것.

# ---------- 업비트 Open API ----------
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# ---------- 텔레그램 원격제어 (선택이지만 강력 권장) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- 엔진 설정 ----------
DB_PATH=data/upbit.db
INITIAL_EQUITY_KRW=1000000
# 일일 손실 기준선을 고정하고 싶을 때만 지정 (비우면 시작 시 총 평가액 사용)
START_EQUITY_KRW=
MAX_DAILY_LOSS_PCT=0.05
MAX_DAILY_TRADES=30
MAX_ORDERS_PER_CYCLE=10
CYCLE_SECONDS=60

# 종목 재정의 (쉼표 구분, 비우면 기본 10종)
TICKERS=
