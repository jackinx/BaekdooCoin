# ============================================================
# 백두코인봇 환경설정 파일 (.env)
# ============================================================
# 이 파일은 절대 git에 커밋하지 마세요. (.gitignore에 포함됨)
# 실제 키를 아래 값에 입력하고 저장하세요.
#
# 이 파일을 복사해서 사용: cp .env.example .env
# ============================================================

# ---------- 업비트 API 키 ----------
# 업비트 웹사이트: https://upbit.com/service_center/open_api_guide
#   로그인 → [API 키 관리] → Open API 사용 신청
#   발급 시 "출금" 권한은 절대 체크하지 마세요 (주문/조회만)
#   IP 제한은 가능하면 설정하세요 (자동매매 실행 서버 IP)
UPBIT_ACCESS_KEY=여기에_액세스키_입력
UPBIT_SECRET_KEY=여기에_시크릿키_입력

# ---------- 텔레그램 봇 (원격제어 + 알림) ----------
# BotFather(@BotFather)에서 봇 생성 후 토큰 발급
#   /newbot → 이름 입력 → 봇토큰 복사
TELEGRAM_BOT_TOKEN=여기에_봇토큰_입력
# 내 chat_id 확인: @userinfobot 에게 메시지 보내면 나옴
TELEGRAM_CHAT_ID=여기에_챗아이디_입력

# ---------- 웹훅 (TradingView 연동, 선택사항) ----------
# TradingView 얼럿에서 사용할 시크릿 토큰
WEBHOOK_SECRET_KEY=여기에_웹훅시크릿_입력

# ---------- 서버 설정 ----------
PORT=8080
